{
  "name": "wardrobe",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs",
    "lint": "eslint src",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm test && npm run build && node scripts/validate-release.mjs",
    "release:prepare": "npm run check && node scripts/package-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.30.1",
    "@eslint/json": "0.14.0",
    "@types/node": "^16.11.6",
    "esbuild": "0.25.5",
    "eslint": "9.30.1",
    "eslint-plugin-obsidianmd": "0.1.9",
    "obsidian": "1.14.4",
    "tslib": "2.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.35.1",
    "yaml": "2.8.3"
  },
  "license": "GPL-3.0-only",
  "description": "Build outfits from clothing notes in Obsidian.",
  "overrides": {
    "moment": "^2.31.0"
  }
}
